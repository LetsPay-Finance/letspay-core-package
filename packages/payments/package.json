{
  "name": "@letspay-dev/payments",
  "version": "0.1.0",
  "description": "Universal TypeScript SDK for interacting with LetsPay Hedera proxy",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --sourcemap --clean",
    "dev": "tsup src/index.ts --dts --format esm,cjs --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck"
  },
  "keywords": [
    "hedera",
    "payments",
    "sdk",
    "viem",
    "escrow"
  ],
  "peerDependencies": {
    "viem": "^2.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "tsup": "^8.0.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}

